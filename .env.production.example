# ─── Production environment ────────────────────────────────────────────────
# Copy to .env.production and fill in every value below. Never commit the
# real .env.production file.

# ─── Security (REQUIRED) ──────────────────────────────────────────────────
# Secret that gates every /api/v1/* request. The SPA sends it as the
# X-API-Key header. Generate with:  openssl rand -hex 32
API_KEY_SECRET=changeme

# Redis password (REQUIRED). Generate with:  openssl rand -hex 16
REDIS_PASSWORD=changeme

# Comma-separated CORS origins the browser UI may be served from.
# E.g.  ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=https://your-app-domain.example.com

# ─── Public entrypoint ────────────────────────────────────────────────────
# Host port the API is published on (leave 8000 unless it collides).
API_PORT=8000

# ─── Ray sizing ───────────────────────────────────────────────────────────
# Sized for an Azure B2ms student VM (2 vCPU / 8 GB): head schedules only
# (num-cpus 0) + 2 workers x 1 CPU, ~7.75 GB total. Raise on larger machines.
RAY_HEAD_CPUS=0
RAY_WORKER_CPUS=1
RAY_WORKER_REPLICAS=2

# ─── Processing ───────────────────────────────────────────────────────────
CHUNK_SIZE_ROWS=50000
MAX_CONCURRENT_TASKS=4
MAX_FILE_SIZE_MB=500

# ─── Storage ──────────────────────────────────────────────────────────────
STORAGE_TYPE=local           # "local" or "s3"
# S3 backend — leave blank when STORAGE_TYPE=local. Prefer IAM roles.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1

# ─── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO