# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Redis password (strongly recommended in production)
# REDIS_PASSWORD=changeme

# ─── Ray ─────────────────────────────────────────────────
RAY_ADDRESS=ray://ray-head:10001
# Use "local" for single-machine / CI runs: RAY_ADDRESS=local

# ─── Storage ─────────────────────────────────────────────
STORAGE_TYPE=local           # "local" or "s3"
STORAGE_PATH=/storage

# S3 backend — leave blank when STORAGE_TYPE=local
# Never commit real credentials. Use IAM roles in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1

# ─── Processing ───────────────────────────────────────────
CHUNK_SIZE_ROWS=50000
MAX_CONCURRENT_TASKS=8

# ─── Security ────────────────────────────────────────────
# Comma-separated allowed CORS origins, or "*" for dev only.
# In production set this to your actual domain(s):  ALLOWED_ORIGINS=https://app.example.com
ALLOWED_ORIGINS=*

# Optional API key gate. If set, all /api/v1/* requests require
# the header:  X-API-Key: <value>
# API_KEY_SECRET=

# Max upload size in megabytes
MAX_FILE_SIZE_MB=500

# ─── Security hardening ──────────────────────────────────────
# Rate limit POST requests per client IP per minute (0 = disabled)
RATE_LIMIT_PER_MINUTE=0
# CSP connect-src. "'self'" for a same-origin SPA; set your API base URL
# here if the SPA points at a separate backend.
# CSP_CONNECT_SRC='self'
# Emit Strict-Transport-Security header (TLS only)
# ALLOW_HSTS=true

# ─── Development / demo ─────────────────────────────────
# When true, enables the fault-injection demo (/api/v1/demo/fault and the
# demo_fail_chunks upload field) used to visualise the retry/recovery path.
# Leave false in production.
DEMO_MODE=false

# Upper bound for the /api/v1/benchmark row count
MAX_BENCHMARK_ROWS=2000000

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=INFO
